# havenfold-kutu-ubuntu.service — Aile Kutusu, "Var olan Ubuntu" kipi (RFC-0007 §8.6; D76). Kurulum betiği
# (deploy/havenfold-install-sudo.sh) bunu /etc/systemd/system/havenfold-kutu.service olarak kurar. Tam düğüm kurulumundaki
# havenfold-kutu.service'ten farkı: denetçi yok (kutu tek başına), çekirdek Node'da (Bare'e geçiş İstek 151), disk
# şifresiz bildirilir. Kutu yeniden başlayınca ve makine açılınca kendiliğinden kalkar.
[Unit]
Description=Havenfold Aile Kutusu (var olan Ubuntu)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=havenfold-kutu
Group=havenfold-kutu
# tss: /dev/tpmrm0; havenfold-yonetim: yönetim soketinin grubu (havenfold durum, katil)
SupplementaryGroups=tss havenfold-yonetim
Environment=HF_KUTU_DIZIN=/var/lib/havenfold/kutu
Environment=HF_KUTU_SOKET=/run/havenfold/kutu/yonetim.sock
Environment=HF_DISK=sifresiz
ExecStart=/opt/havenfold/guncel/bin/node /opt/havenfold/guncel/node/box.js
Restart=always
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
DevicePolicy=closed
# yalnız TPM; başka aygıt yok
DeviceAllow=/dev/tpmrm0 rw
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallFilter=@system-service
SystemCallArchitectures=native
UMask=0077
# MemoryDenyWriteExecute kullanılmaz: V8'in JIT derleyicisi yazılabilir ve çalıştırılabilir bellek ister
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
ReadWritePaths=/var/lib/havenfold/kutu /run/havenfold/kutu

[Install]
WantedBy=multi-user.target
