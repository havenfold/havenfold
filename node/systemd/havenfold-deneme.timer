# havenfold-deneme.timer — RFC-0026 d: deneme kaydı varken her dakika; yoksa hizmet hemen biter
[Unit]
Description=Havenfold güncelleme denemesi zamanlayıcısı

[Timer]
OnBootSec=1min
OnUnitActiveSec=1min
AccuracySec=10s

[Install]
WantedBy=timers.target
