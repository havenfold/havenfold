# havenfold-acilis.service — RFC-0026 d: açılış sayacı. Deneme penceresinde her açılış sayılır; üçüncü açılışta sağlık
# yoksa denetçi başlamadan önceki sürüme dönülür.
[Unit]
Description=Havenfold açılış sayacı
Before=havenfold-denetci.service
DefaultDependencies=no
After=local-fs.target

[Service]
Type=oneshot
ExecStart=/usr/lib/havenfold/yetki/node /usr/lib/havenfold/yetki/ana.js deneme-denetle --acilis
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
AmbientCapabilities=
SystemCallFilter=@system-service
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX
UMask=0022
ReadWritePaths=/opt/havenfold /var/lib/havenfold/yetki

[Install]
WantedBy=multi-user.target
