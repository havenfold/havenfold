# havenfold-deneme.service — RFC-0026 d: sağlık penceresinin denetimi. Kökün dizinindeki deneme kaydına bakar; pencere
# doldu ve sağlık gelmediyse önceki sürüme döner. Yeni sürümün kodu bu kararda yer almaz (yardımcının sabit yolu).
[Unit]
Description=Havenfold güncelleme denemesi denetimi

[Service]
Type=oneshot
ExecStart=/usr/lib/havenfold/yetki/node /usr/lib/havenfold/yetki/ana.js deneme-denetle
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
AmbientCapabilities=
SystemCallFilter=@system-service
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX
UMask=0022
ReadWritePaths=/opt/havenfold /var/lib/havenfold/yetki
