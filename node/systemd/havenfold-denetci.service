# havenfold-denetci.service — RFC-0007 §4.3. Bu dosya düğüm paketiyle gelir; kurulum aracı /etc/systemd/system altına bağlar.
[Unit]
Description=Havenfold denetçi (görev çalıştırıcı, yedek deposu, sağlık, güncelleme)

[Service]
Type=simple
User=havenfold-denetci
Group=havenfold-denetci
ExecStart=/opt/havenfold/guncel/node /opt/havenfold/guncel/denetci/ana.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
DevicePolicy=closed
# yalnız TPM; başka aygıt yok
DeviceAllow=/dev/tpmrm0 rw
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallFilter=@system-service
SystemCallArchitectures=native
UMask=0077
# MemoryDenyWriteExecute kullanılmaz: V8'in JIT derleyicisi yazılabilir ve çalıştırılabilir bellek ister
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/havenfold/denetci /run/havenfold/denetci /run/havenfold/denetci-yonetim /var/lib/havenfold/yedek /run/havenfold/gorev
# Yardımcı soketine birincil grubu havenfold-denetci ile bağlanır (/run/havenfold/yetki/, RFC-0033 §9 l);
# havenfold-podman: görev konteynerlerinin Podman API soketi (/run/havenfold/podman/podman.sock).
# havenfold-yonetim yok (açılış güvenlik incelemesi): o grup çekirdeklerin yönetim soketlerine (havenfold katil) erişir.
# Denetçinin kendi yönetim soketinin grubu setgid dizinden gelir (tmpfiles: /run/havenfold/denetci-yonetim 2750).
# Çekirdeklerin /run/havenfold/<rol>/ dizinindeki yedek blokları (YEDEK_YAZ; bugün çağıran yok) bağlandığında ayrı yol ister.
SupplementaryGroups=havenfold-gorev tss havenfold-podman

[Install]
WantedBy=multi-user.target
