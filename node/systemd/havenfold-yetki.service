# havenfold-yetki.service — RFC-0007 §6.4, RFC-0026 b, g: sabit işlem listeli kök yardımcı; işi bitince kapanır.
# Kod güncellenen sürümden (/opt/havenfold/guncel) çalışmaz: kurulumda gelen /usr/lib/havenfold/yetki/'den. guncel bağı
# yardımcıyı hiçbir zaman değiştirmez. Yazabildiği yollar ReadWritePaths ile sınırlıdır; geri kalan her şey salt okunur.
[Unit]
Description=Havenfold yetki yardımcısı
Requires=havenfold-yetki.socket

[Service]
Type=simple
ExecStart=/usr/lib/havenfold/yetki/node /usr/lib/havenfold/yetki/ana.js
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
# Denetçinin önbelleğini (0700) ve çekirdek kimliklerinin varlığını okumak için; başka yetki yok
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
AmbientCapabilities=
SystemCallFilter=@system-service
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX
UMask=0022
ReadWritePaths=/opt/havenfold /var/lib/havenfold/yetki -/sys/class/power_supply -/boot/efi/EFI/havenfold
TimeoutStopSec=30
