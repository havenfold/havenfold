# havenfold — paketteki komut (RFC-0007 §5, §7): /usr/local/bin/havenfold → /opt/havenfold/guncel/bin/havenfold.
# Paketle gelen Node ile lib/node/bin/havenfold'u çalıştırır; sistemin Node'u kullanılmaz (RFC-0007 §4.1).
set -eu
KOK=$(dirname "$(dirname "$(readlink -f "$0")")")
exec "$KOK/node" "$KOK/lib/node/bin/havenfold" "$@"
