# /etc/havenfold/ag-kapali.nft — silme ortamı (RFC-0007 §13.2): geri döngü dışında her şey düşer. Rapor yalnız QR ile çıkar.
flush ruleset
table inet havenfold-sil {
  chain gelen { type filter hook input priority filter; policy drop; iif "lo" accept; }
  chain giden { type filter hook output priority filter; policy drop; oif "lo" accept; }
  chain ileri { type filter hook forward priority filter; policy drop; }
}
