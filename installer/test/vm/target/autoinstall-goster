# autoinstall-goster — YALNIZ TEST ISO'SU: early-commands'ın değiştirdiği /autoinstall.yaml'ı yazar (geçici LUKS
# parolası *** ile) ve kurulum ortamındaki Python YAML ayrıştırıcısıyla (varsa) denetler.
P=/run/havenfold-kurulum/luks-gecici
F=/autoinstall.yaml
echo "===== $F"
if [ -s "$P" ]; then sed "s/$(cat "$P")/***/g" "$F"; else cat "$F"; fi
if command -v python3 >/dev/null && python3 -c 'import yaml' 2>/dev/null; then
  python3 -c 'import sys, yaml; d = yaml.safe_load(open(sys.argv[1])); print("YAML geçerli; üst anahtarlar:", " ".join(sorted(d)))' "$F"
fi
exit 0
