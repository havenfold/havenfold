# hf-test-denetim.service — YALNIZ TEST ISO'SU: sanal makine denemesinde ilk açılışın sonuçlarını seri konsola yazar.
[Unit]
Description=Havenfold sanal makine denemesi: ilk açılış denetimi
After=local-fs.target

[Service]
Type=simple
ExecStart=/usr/local/sbin/hf-test-denetim
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
