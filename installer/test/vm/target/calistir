# calistir — YALNIZ TEST ISO'SU: kurulum komutunu çıktısı ve soruları ikinci seri kapıda (ttyS1) olacak biçimde
# çalıştırır. CI sürücüsü (installer/test/vm/driver.js) ttyS1'i okur ve hf-on-kontrol'ün "SIL" sorusunu yanıtlar.
# Üretim komutu değişmeden çalışır; yalnız HF_TTY ve çıktı yönü farklıdır.
T=/dev/ttyS1
[ -c "$T" ] || { echo "calistir: $T yok" >&2; exec "$@"; }
exec >"$T" 2>&1
printf '\n[hf-test] %s %s\n' "$(date -u +%H:%M:%S)" "$*"
export HF_TTY=$T
"$@"
s=$?
printf '[hf-test] çıkış %s: %s\n' "$s" "$1"
exit "$s"
