// Test aracı: coreutils `b2sum -l 256` taklidi (macOS'ta b2sum yok). Anahtarsız BLAKE2b-256, libsodium ile.
// Yalnız `-l 256` ve stdin desteklenir; çıktı biçimi coreutils'inki gibi: "<onaltılık>  -".
const sodium = require('sodium-native')
const args = process.argv.slice(2)
if (args.join(' ') !== '-l 256') { process.stderr.write('b2sum taklidi: yalnız -l 256\n'); process.exit(2) }
const girdi = require('fs').readFileSync(0)
const out = Buffer.alloc(32)
sodium.crypto_generichash(out, girdi)
process.stdout.write(out.toString('hex') + '  -\n')
