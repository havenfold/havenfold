#!/usr/bin/env bash
# SPDX-License-Identifier: MPL-2.0
# This Source Code Form is subject to the terms of the Mozilla Public License, v. 2.0. If a copy of the MPL
# was not distributed with this file, You can obtain one at https://mozilla.org/MPL/2.0/.
# havenfold-kur — var olan Ubuntu Server 24.04 LTS'ye Havenfold düğümü kurar (RFC-0007 §8.6). Diski silmez.
#
#   sudo bash havenfold-kur [--rol isci|kutu|birlesik] [--kanal kararli|deneme] [--laptop evet|hayir]
#                           [--etiket vX.Y.Z[-ek]] [--kaynak URL] [--bildirim DOSYA --paket DOSYA]
#
# Tek dosyadır; sürüm sayfasında SHA-256'sıyla yayımlanır. İçinde kök anahtar durumu sabittir (aşağıda). Önce sürüm
# bildirimini indirip doğrular (OpenSSL ile Ed25519 imzası, b2sum ile özet), sonra paketi indirip özetini denetler.
# Ubuntu paketlerini Ubuntu arşivinden apt ile kurar; clevis yoktur, diske dokunulmaz. SSH'a, güvenlik duvarına ve var
# olan servislere dokunmaz: yalnız kendi nftables tablosunu (inet havenfold, hiçbir şeyi engellemez) ekler.
# Laptop ayarlarını (§10) yalnız pil varsa ve "E" denirse (ya da --laptop evet) uygular.
#
# Bu dosya şablondan üretilir (installer/build/havenfold-install-build.sh); @...@ yer tutucuları derlemede dolar.
set -euo pipefail
umask 022

HF_KOK_DURUMU='@KOK_DURUMU@'   # kokDurumuEnc: keyEpoch ‖ rootPub ‖ nextRootHash (onaltılık)
HF_ARAC_SURUMU='@SURUM@'
# Sürüm bildirimi GitHub Releases'ten iner (docs/surum.md): kararlı kanalda en son yayımlanmış sürüm (latest), deneme
# kanalında en yeni yayımlanmış ön sürüm (GitHub API'si; taslaklar görünmez). --etiket belirli bir sürümü seçer.
# --kaynak ya da HF_KAYNAK aynı düzende bir yansıdır: <kaynak>/latest/download/<dosya>, <kaynak>/download/<etiket>/<dosya>.
# Paketin adresleri imzalı bildirimin içindedir.
KAYNAK=${HF_KAYNAK:-https://github.com/havenfold/havenfold/releases}
ROL=isci KANAL=kararli LAPTOP="" ETIKET="" YEREL_BILDIRIM="" YEREL_PAKET=""

hata () { echo "HATA: $1" >&2; exit "${2:-1}"; }
while [ $# -gt 0 ]; do
  case "$1" in
    --rol) ROL=$2 ;; --kanal) KANAL=$2 ;; --laptop) LAPTOP=$2 ;; --kaynak) KAYNAK=$2 ;; --etiket) ETIKET=$2 ;;
    --bildirim) YEREL_BILDIRIM=$2 ;; --paket) YEREL_PAKET=$2 ;; *) hata "bilinmeyen seçenek: $1" 1 ;;
  esac
  shift 2
done
case "$ROL" in isci|kutu|birlesik) ;; *) hata "--rol isci, kutu ya da birlesik" 1 ;; esac
case "$KANAL" in kararli|deneme) ;; *) hata "--kanal kararli ya da deneme" 1 ;; esac
case "$LAPTOP" in ""|evet|hayir) ;; *) hata "--laptop evet ya da hayir" 1 ;; esac
ETIKET_RE='^v(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)(-[0-9A-Za-z.]+)?$'
[ -z "$ETIKET" ] || [[ "$ETIKET" =~ $ETIKET_RE ]] || hata "--etiket vX.Y.Z[-ek] olmalı" 1
case "$KAYNAK" in https://*) KAYNAK=${KAYNAK%/} ;; *) hata "--kaynak https:// ile başlamalı" 1 ;; esac

[ "$(id -u)" -eq 0 ] || hata "sudo ile çalıştırın: sudo bash $0" 2
[ -f "$0" ] || hata "dosyayı indirip çalıştırın (borudan çalışmaz)" 1
# shellcheck disable=SC1091
. /etc/os-release
[ "${ID:-}" = ubuntu ] && [ "${VERSION_ID:-}" = "24.04" ] || hata "yalnız Ubuntu Server 24.04 LTS (bu sistem: ${PRETTY_NAME:-bilinmiyor})" 3
ARCH=$(dpkg --print-architecture)
case "$ARCH" in amd64|arm64) ;; *) hata "yalnız amd64 ya da arm64 (bu sistem: $ARCH)" 3 ;; esac
for a in openssl b2sum od curl python3 base64 tar; do command -v "$a" >/dev/null || hata "$a yok" 3; done

IS=$(mktemp -d /run/havenfold-kur.XXXXXX)
trap 'rm -rf "$IS"' EXIT
adim () { printf '\n== %s\n' "$1"; }

# Sürüm bildiriminin adresi (yukarıdaki KAYNAK düzeni). Deneme kanalında etiket verilmemişse GitHub API'sinden en yeni
# yayımlanmış ön sürümün etiketi alınır; kanal yine bildirimin imzalı alanıyla denetlenir.
bildirim_adresi () {
  local e=$ETIKET depo
  if [ -z "$e" ] && [ "$KANAL" = kararli ]; then echo "$KAYNAK/latest/download/havenfold-node.bildirim"; return; fi
  if [ -z "$e" ]; then
    [[ "$KAYNAK" =~ ^https://github\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/releases$ ]] || hata "deneme kanalında yansıdan kurmak için --etiket verin" 1
    depo=${KAYNAK#https://github.com/}; depo=${depo%/releases}
    e=$(curl -fsSL --proto '=https' -A havenfold-node "https://api.github.com/repos/$depo/releases?per_page=30" | python3 -I -c '
import json, sys
for r in json.load(sys.stdin):
    if r.get("prerelease") and not r.get("draft"): print(r["tag_name"]); break
') || hata "sürüm listesi alınamadı" 4
    [[ "$e" =~ $ETIKET_RE ]] || hata "yayımlanmış deneme sürümü yok" 4
  fi
  echo "$KAYNAK/download/$e/havenfold-node.bildirim"
}

adim "Kurulum aracı (bu dosyanın içinden)"
mkdir -p "$IS/kurulum"
sed '1,/^__HAVENFOLD_YUK__$/d' "$0" | base64 -d | tar -xz -C "$IS/kurulum"
# shellcheck source=notification.sh
. "$IS/kurulum/install/notification.sh"
hf_kok_durumu_coz "$HF_KOK_DURUMU" || hata "gömülü kök durumu bozuk" 5
# Var olan kurulumda makinenin kökü gömülüden yeniyse güven kökü odur (aday paket çalışmadan önce); kurulu düğümün kök ya
# da sürüm durumu kaybolmuşsa ilk kurulum sayılmaz
hf_kurulum_durumu "" ||
  hata "kurulu düğümün kök ya da sürüm durumu eksik (/var/lib/havenfold/yetki); yedekten geri yükleyin ya da Kurulum USB'siyle yeniden kurun" 5
hf_kurulu_kok_sec /var/lib/havenfold/yetki/kok.durum || hata "kurulu kök durumu kullanılamıyor: $HF_HATA" 5
echo "havenfold-kur $HF_ARAC_SURUMU · kök dönemi $HF_KOK_DONEM"

adim "Sürüm bildirimi"
mkdir -p "$IS/paket"
if [ -n "$YEREL_BILDIRIM" ]; then cp "$YEREL_BILDIRIM" "$IS/paket/bildirim.bin"
else
  ADRES=$(bildirim_adresi) || exit $?
  echo "kaynak: $ADRES"
  curl -fsSL --proto '=https' -A havenfold-node -o "$IS/paket/bildirim.bin" "$ADRES" || hata "bildirim indirilemedi" 4
fi
if ! hf_bildirim_dogrula "$IS/paket/bildirim.bin" "$KANAL" linux "$ARCH"; then
  [ "$HF_HATA" = ROOT_EPOCH_ERROR ] && hata "kök anahtar döndürülmüş; sürüm sayfasından yeni havenfold-kur dosyasını indirin" 5
  hata "bildirim doğrulanamadı: $HF_HATA" 5
fi
echo "havenfold-node $HF_SURUM ($HF_KANAL) doğrulandı"
# Var olan kurulumda sürüm düşürme ya da geri çekilmiş sürüm: paket inmeden, paketteki Node çalışmadan ve kalıcı araçlar
# değişmeden durur (RFC-0026 c)
hf_surum_denetle /var/lib/havenfold/yetki/yetki.durum ||
  hata "kurulu sürümden düşük ya da geri çekilmiş sürüm kurulmaz ($HF_HATA; havenfold geri-al ebeveyn onayıyla)" 3

adim "Düğüm paketi"
if [ -n "$YEREL_PAKET" ]; then cp "$YEREL_PAKET" "$IS/paket/$HF_PAKET_ADI"
else
  ok=0
  while IFS= read -r u; do
    [ -n "$u" ] || continue
    curl -fsSL --proto '=https' -A havenfold-node -o "$IS/paket/$HF_PAKET_ADI" "$u" && { ok=1; break; }
  done <<< "$HF_PAKET_URLS"
  [ "$ok" = 1 ] || hata "paket indirilemedi" 4
fi
hf_paket_denetle "$IS/paket/$HF_PAKET_ADI" || hata "paket özeti tutmuyor" 5
echo "özet tamam"
# Paketteki Node çalışma zamanı (doğrulanmış paketten): kurulum aracının geri kalanı bununla çalışır
python3 -I - "$IS/paket/$HF_PAKET_ADI" "$IS/kurulum/node" <<'PY'
import sys, zipfile, os
with zipfile.ZipFile(sys.argv[1]) as z:
    ad = next((n for n in ('node', 'bin/node') if n in z.namelist()), None)
    if ad is None: sys.exit('pakette Node yok')
    with z.open(ad) as g, open(sys.argv[2], 'wb') as c: c.write(g.read())
os.chmod(sys.argv[2], 0o755)
PY
hf_hex_ikili "$HF_KOK_DURUMU" > "$IS/paket/kok.durum"
cat > "$IS/paket/paket.json" <<JSON
{ "surum": "$HF_SURUM", "versionCode": $HF_KOD, "kanal": "$HF_KANAL", "paketAdi": "$HF_PAKET_ADI", "paketOzeti": "$HF_PAKET_OZET", "bildirimOzeti": "$HF_BILDIRIM_OZETI" }
JSON

# common.sh okur (kaynak olarak)
# shellcheck disable=SC2034
KOK=""
KURULUM=$IS/kurulum
# shellcheck disable=SC2034
PAKET_DIZ=$IS/paket
hedefte () { "$@"; }
# shellcheck source=../target/common.sh
. "$KURULUM/target/common.sh"

adim "Ubuntu paketleri (apt; clevis yok, diske dokunulmaz)"
DEBIAN_FRONTEND=noninteractive apt-get install -y podman uidmap slirp4netns tpm2-tools smartmontools nvme-cli nftables wpasupplicant

adim "Kurulum aracı: /usr/lib/havenfold/kurulum"
hf_kurulum_kopyala
adim "Düğüm paketi: /opt/havenfold"
hf_paket_ac
adim "Kullanıcılar, gruplar, dizinler"
hf_kullanicilar
[ -n "${SUDO_USER:-}" ] && [ "$SUDO_USER" != root ] && usermod -aG havenfold-yonetim "$SUDO_USER"
adim "Kökün durumu ve yetki yardımcısı"
hf_yetki

PIL=0
for t in /sys/class/power_supply/*/type; do
  [ -e "$t" ] || continue
  [ "$(cat "$t")" = Battery ] && [ "$(cat "$(dirname "$t")/scope" 2>/dev/null || echo System)" != Device ] && PIL=1
done
if [ "$PIL" = 1 ] && [ -z "$LAPTOP" ]; then
  printf 'Bu bir dizüstü. Kapak kapanınca uyumama, uyku hedeflerini kapatma, pil şarj sınırı ve güvenlik yaması ayarları uygulansın mı? (E/H) '
  read -r c || c=""
  case "$c" in E|e) LAPTOP=evet ;; *) LAPTOP=hayir ;; esac
fi
if [ "$LAPTOP" = evet ]; then
  adim "Laptop ve sistem ayarları (§10)"
  hf_laptop
  hf_sistem_ayarlari
fi
hf_nft var-olan
hf_dugum_toml "$ROL" "$KANAL" "$HF_PIL_SINIR"

adim "systemd birimleri"
hf_birimler havenfold-denetci.service havenfold-kutu.service havenfold-isci.service havenfold-yetki.socket \
  havenfold-pil.service havenfold-acilis.service havenfold-deneme.timer havenfold-nft.service
# restart: yeniden çalıştırmada (--etiket) çalışan birimler yeni sürüme ve yeni kural dosyasına geçer
systemctl start havenfold-yetki.socket || echo "UYARI: havenfold-yetki.socket başlamadı (journalctl -u havenfold-yetki.socket)" >&2
systemctl restart havenfold-nft.service havenfold-denetci.service || echo "UYARI: havenfold-nft ya da havenfold-denetci başlamadı (journalctl -u havenfold-denetci)" >&2

# Kimlikler (RFC-0007 §9 adım 7): çekirdek birimleri ConditionPathExists ile <rol>/kimlik işaretini bekler; ilk-ayar
# üretmeden birim başlamaz ve `havenfold katil` soket bulamaz. Var olan kimliğe dokunmaz (yeniden çalıştırılabilir).
adim "Kimlikler"
if ! /opt/havenfold/guncel/bin/havenfold ilk-ayar --rol "$ROL"; then
  echo "HATA: kimlikler üretilemedi. Kurulum tamamlanmadı; sorunu giderip havenfold-kur'u yeniden çalıştırın." >&2
  exit 1
fi
case "$ROL" in
  isci) CEKIRDEK=(havenfold-isci.service) ;;
  kutu) CEKIRDEK=(havenfold-kutu.service) ;;
  birlesik) CEKIRDEK=(havenfold-kutu.service havenfold-isci.service) ;;
esac
if ! systemctl restart "${CEKIRDEK[@]}"; then
  echo "HATA: çekirdek başlamadı: ${CEKIRDEK[*]}. Ayrıntı: journalctl -u ${CEKIRDEK[0]}" >&2
  exit 1
fi

# Disk şifresiz: neyin açığa çıkacağı TPM'ye bağlı (Codex 9. tur: TPM'siz düğümde kimlik anahtarları da diskteki
# dosyalardan açılır)
if [ -e /dev/tpmrm0 ]; then
  TPM="var (kimlik ve kasa payları TPM'ye mühürlenir)"
  DISK="Disk şifresiz: diski çalınan kişiye kimlik değil, emanet üst verisi ve uygulama verisi açığa çıkar; zarflar uçtan uca
şifrelidir."
else
  TPM="yok (düğümün anahtarları diskte, şifresiz dosyada)"
  DISK="Disk şifresiz ve TPM yok: diski çalınan kişi düğümün kimliğini ve anahtarlarını da ele geçirir (o düğüm gibi davranabilir);
emanet üst verisi ve uygulama verisi de açığa çıkar. Zarflar uçtan uca şifrelidir. Böyle bir düğümü kaybedince ebeveyn
onu aileden çıkarmalıdır."
fi
cat <<SON

Tamam. havenfold-node $HF_SURUM kuruldu (rol: $ROL, kanal: $KANAL).
TPM: $TPM
$DISK
Diski şifrelemek için Kurulum USB'siyle yeniden kurun.
Tören için (yönetim grubuna girdikten sonra: oturumu kapatıp açın): havenfold katil --rol $ROL
SON
exit 0
__HAVENFOLD_YUK__
